@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using USDM_MindMap_Editor.Core.Layout
@using USDM_MindMap_Editor.Core.Models
@using USDM_MindMap_Editor.Core.Editing
@using USDM_MindMap_Editor.Core.Ids
@using USDM_MindMap_Editor.Web.State
@using USDM_MindMap_Editor.Web.Components.Editor
@inject AutoLayoutService LayoutService
@inject NodeCreationService NodeCreation
@inject IJSRuntime JS

<PageTitle>USDM MindMap Editor</PageTitle>

<div class="editor-shell" style="@ToolbarSettingsStyle" data-toolbar-visible="@_toolbarVisible.ToString().ToLowerInvariant()">
    <button type="button" class="toolbar-toggle" tabindex="0" @ref="_toolbarToggleElement"
            title="@ToolbarToggleLabel" aria-label="@ToolbarToggleLabel"
            aria-expanded="@_toolbarVisible.ToString().ToLowerInvariant()" aria-controls="@_toolbarId"
            disabled="@(_additionTarget is not null || _savingNode || _closingAddition)"
            @onclick="ToggleToolbarAsync" @onclick:stopPropagation="true"
            @ondblclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="@(_toolbarVisible ? "chevron-up" : "chevron-down")">
            <path d="M 6 15 L 12 9 L 18 15" />
        </svg>
    </button>
    <header class="editor-toolbar" id="@_toolbarId" hidden="@(!_toolbarVisible)">
        <div class="toolbar-actions">
            <button type="button" tabindex="0">新規</button>
            <button type="button" tabindex="0">開く</button>
            <button type="button" tabindex="0">保存</button>
            <button type="button" tabindex="0">エクスポート</button>
            <button type="button" tabindex="0" @onclick="OpenBackgroundAsync">背景追加</button>
        </div>
    </header>

    <main class="mindmap-canvas" @ref="_canvasElement" aria-label="マインドマップキャンバス" tabindex="-1"
          data-layout-revision="@_session.Revision" data-unsaved="@_session.HasUnsavedChanges.ToString().ToLowerInvariant()"
          style="--child-add-height:@Px(_uiSettings.ChildAddHitHeight / _canvas.Zoom);--child-add-width-ratio:@(_uiSettings.ChildAddWidthRatio.ToString(CultureInfo.InvariantCulture))">
        <div class="mindmap-world">
          <div class="mindmap-content" style="@WorldStyle">
            <svg class="connectors" width="@Number(_layout.CanvasBounds.Width)" height="@Number(_layout.CanvasBounds.Height)"
                 style="@SvgStyle" viewBox="@SvgViewBox" aria-hidden="true">
                @foreach (var tree in _layout.Trees)
                {
                    <g @key="tree.BackgroundId" class="tree-connectors" data-background-id="@tree.BackgroundId">
                        @foreach (var edge in tree.Edges)
                        {
                            <path @key="edge.ChildId" data-parent="@edge.ParentId" data-child="@edge.ChildId" d="@PathFor(edge)" />
                        }
                    </g>
                }
            </svg>
            @foreach (var tree in _layout.Trees)
            {
                <div @key="tree.BackgroundId" class="tree-nodes" data-background-id="@tree.BackgroundId"
                     data-position-x="@Number(tree.Position.X)" data-position-y="@Number(tree.Position.Y)">
                    @foreach (var node in tree.Nodes)
                    {
                        <article @key="node.Key" class="node @NodeClass(node.Kind)" id="node-@node.Key" style="@NodeStyle(node)">
                            <span class="node-id">@node.Id</span>
                            <p>@node.Text</p>
                            @if (!string.IsNullOrWhiteSpace(node.Reason))
                            {
                                <details open="@IsReasonExpanded(node.Key)"><summary>理由</summary><p>@node.Reason</p></details>
                            }
                            @if (ChildKind(node.Kind) is { } childKind)
                            {
                                <button type="button" class="child-add-region" data-parent-key="@node.Key"
                                        data-tooltip="@AdditionLabel(childKind)" aria-label="@AdditionLabel(childKind)"></button>
                            }
                        </article>
                    }
                </div>
            }
          </div>
        </div>
    </main>

    <footer class="editor-status"><span role="status">@_statusText</span> ・ version 0.1.0 ・ <span class="zoom-status">100%</span></footer>
    @if (_additionTarget is { } target)
    {
        <NodeInputDialog @key="target" @ref="_nodeDialog" Kind="target.Kind" ParentLabel="@target.ParentLabel" ErrorMessage="@_additionError"
                         RelatedRequirements="_relatedRequirements"
                         OnSave="input => SaveNodeAsync(target, input)" OnCancel="() => CloseAdditionAsync(target)" />
    }
</div>

@code {
    [Parameter] public UsdmDocument? Document { get; set; }

    private readonly LayoutSettings _settings = new();
    private readonly WebUiSettings _uiSettings = new();
    private readonly CanvasState _canvas = new();
    private DocumentEditingSession _session = null!;
    private UsdmDocument _document => _session.Document;
    private LayoutResult _layout => _session.Layout;
    private long _sentLayoutRevision;
    private bool _disposed;
    private ElementReference _canvasElement;
    private ElementReference _toolbarToggleElement;
    private readonly string _toolbarId = $"editor-toolbar-{Guid.NewGuid():N}";
    private bool _toolbarVisible = true;
    private bool _toolbarToggleInProgress;
    private bool _toolbarCompletionPending;
    private bool _toolbarCancellationPending;
    private IJSObjectReference? _canvasModule;
    private DotNetObjectReference<Home>? _dotNetReference;
    // Reference identity also makes every dialog invocation a distinct Blazor key.
    private sealed class AdditionTarget(LayoutNodeKind kind, string? parentId = null, string? parentLabel = null,
        LayoutPoint? backgroundPosition = null)
    {
        public LayoutNodeKind Kind { get; } = kind;
        public string? ParentId { get; } = parentId;
        public string? ParentLabel { get; } = parentLabel;
        public LayoutPoint? BackgroundPosition { get; } = backgroundPosition;
    }
    private AdditionTarget? _additionTarget;
    private NodeInputDialog? _nodeDialog;
    private bool _closingAddition;
    private string? _additionError;
    private IReadOnlyList<RequirementNode> _relatedRequirements = [];
    private bool _savingNode;
    private string _statusText = "準備完了";

    protected override void OnInitialized()
    {
        _session = new DocumentEditingSession(Document ?? CreateSampleDocument(), _settings, LayoutService, NodeCreation);
        _canvas.Apply(_document.View, _settings);
        if (_session.AutomaticallyMovedBackgroundIds.Count > 0)
            _statusText = PlacementNotice("保存位置の重複を補正しました");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canvasModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mindmapCanvas.js");
            _dotNetReference = DotNetObjectReference.Create(this);
            await _canvasModule.InvokeVoidAsync("attachCanvas", _canvasElement, _dotNetReference,
                _canvas.Zoom, _canvas.PanX, _canvas.PanY, _settings.MinZoom, _settings.MaxZoom, _settings.ZoomStep,
                _uiSettings.ChildAddHitHeight, _uiSettings.ChildAddDragTolerance, _uiSettings.ChildAddWidthRatio,
                _uiSettings.TreeDragTolerance);
        }
        // A toolbar-only render deliberately leaves the layout revision unchanged.
        // Complete the viewport/focus transaction before the revision short circuit.
        if ((_toolbarCompletionPending || _toolbarCancellationPending) && _canvasModule is not null)
        {
            try
            {
                // An earlier render can finish while the async click is awaiting
                // JS. Keep the lock until the DOM actually has the desired state.
                var completed = _toolbarCancellationPending
                    ? await _canvasModule.InvokeAsync<bool>("completeToolbarToggle", _canvasElement, (object?)null)
                    : await _canvasModule.InvokeAsync<bool>("completeToolbarToggle", _canvasElement, _toolbarToggleElement, _toolbarVisible);
                if (completed)
                {
                    _toolbarCompletionPending = false;
                    _toolbarCancellationPending = false;
                    _toolbarToggleInProgress = false;
                }
            }
            catch (JSDisconnectedException)
            {
                // Completion was not acknowledged. Retry on the next render
                // after reconnection instead of forgetting an active JS lock.
            }
        }
        if (_canvasModule is null || _sentLayoutRevision == _session.Revision) return;
        var revision = _session.Revision;
        await _canvasModule.InvokeVoidAsync("updateTreeLayout", _canvasElement, revision, _layout.Trees.Select(tree => new
        {
            backgroundId = tree.BackgroundId,
            position = new { x = tree.Position.X, y = tree.Position.Y },
            bounds = new { x = tree.Bounds.X, y = tree.Bounds.Y, width = tree.Bounds.Width, height = tree.Bounds.Height }
        }).ToArray());
        _sentLayoutRevision = revision;
    }

    private async Task ToggleToolbarAsync()
    {
        if (_disposed || _canvasModule is null || _toolbarToggleInProgress
            || _additionTarget is not null || _savingNode || _closingAddition) return;
        _toolbarToggleInProgress = true;
        var accepted = false;
        try
        {
            // Browser-side gestures must be checked where they run, not inferred
            // from stale server state or synchronized on every pointer movement.
            accepted = await _canvasModule.InvokeAsync<bool>("tryBeginToolbarToggle", _canvasElement);
            if (!accepted || _disposed || _additionTarget is not null || _savingNode || _closingAddition) return;
            _toolbarVisible = !_toolbarVisible;
            _toolbarCompletionPending = true;
        }
        catch (JSDisconnectedException)
        {
            // JS may have acquired the lock even if its reply was interrupted.
            // Preserve a cancellation request for the next successful render.
            _toolbarCancellationPending = true;
        }
        finally
        {
            if (!_toolbarCompletionPending)
            {
                try
                {
                    // A concurrent modal/disposal may have invalidated acceptance.
                    // Release the JS lock without moving focus out of a dialog.
                    if (accepted && !_disposed) await _canvasModule.InvokeVoidAsync("completeToolbarToggle", _canvasElement, (object?)null);
                }
                catch (JSDisconnectedException) { _toolbarCancellationPending = true; }
                finally { _toolbarToggleInProgress = _toolbarCancellationPending; }
            }
        }
    }

    [JSInvokable]
    public async Task<bool> RequestChildAddition(string parentKey)
    {
        if (_disposed || _additionTarget is not null || _closingAddition) return false;
        var parent = _layout.NodesByKey.GetValueOrDefault(parentKey);
        if (parent is null || ChildKind(parent.Kind) is not { } childKind) return false;
        await OpenAdditionAsync(new(childKind, parent.Id, $"{NodeLabel(parent.Kind)} {parent.Id}"));
        return true;
    }

    private Task OpenBackgroundAsync() => OpenAdditionAsync(new(LayoutNodeKind.Background));

    [JSInvokable]
    public async Task<bool> RequestBackgroundAddition(double x, double y)
    {
        if (_disposed || _additionTarget is not null || _closingAddition || !double.IsFinite(x) || !double.IsFinite(y)) return false;
        await OpenAdditionAsync(new(LayoutNodeKind.Background, backgroundPosition: new LayoutPoint(x, y)));
        return true;
    }

    [JSInvokable]
    public async Task<bool> CommitBackgroundMove(string id, double x, double y, long revision)
    {
        if (_disposed || _additionTarget is not null || _savingNode) return false;
        try
        {
            var result = _session.MoveBackground(id, new LayoutPoint(x, y), revision);
            if (!result.IsValid)
                _statusText = "移動できません。他ツリーとの重複または配置変更のため開始位置へ戻しました。";
            else if (result.HasMoved)
                _statusText = $"背景 {id} のツリー全体を移動しました";
            await InvokeAsync(StateHasChanged);
            return result.IsValid && result.HasMoved;
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException)
        {
            _statusText = $"移動を取り消しました：{error.Message}";
            await InvokeAsync(StateHasChanged);
            return false;
        }
    }

    [JSInvokable]
    public Task NotifyBackgroundMoveRejected(string reason)
    {
        _statusText = "他ツリーと重なるため移動できません。ツリー全体を開始位置へ戻しました。";
        return InvokeAsync(StateHasChanged);
    }

    private async Task OpenAdditionAsync(AdditionTarget target)
    {
        if (_disposed || _additionTarget is not null || _closingAddition) return;
        _additionTarget = target;
        _additionError = null;
        _relatedRequirements = target.Kind == LayoutNodeKind.Specification
            ? _document.Requirements.Where(node => node.ParentRequirementId is not null && node.Id != target.ParentId)
                .OrderBy(node => node.Id, UsdmIdRules.NumericSegmentComparer).ToArray()
            : [];
        if (_canvasModule is not null)
            await _canvasModule.InvokeVoidAsync("setAdditionDialogOpen", _canvasElement, true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveNodeAsync(AdditionTarget target, NodeCreationInput input)
    {
        if (_disposed || !ReferenceEquals(_additionTarget, target) || _savingNode || _closingAddition) return;
        _savingNode = true;
        string id;
        try
        {
            id = _session.AddNode(target.Kind, target.ParentId, input.Text, input.Reason,
                input.RelatedRequirementIds, target.BackgroundPosition);
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException)
        {
            _additionError = error.Message;
            _savingNode = false;
            return;
        }
        // Keep view state and existing measurements. ResizeObserver measures only
        // the newly inserted node; the current engine then updates affected positions.
        _statusText = PlacementNotice($"{NodeLabel(target.Kind)} {id} を追加しました");
        _savingNode = false;
        await CloseAdditionAsync(target);
    }

    private async Task CloseAdditionAsync(AdditionTarget target)
    {
        if (!ReferenceEquals(_additionTarget, target) || _savingNode || _closingAddition) return;
        _closingAddition = true;
        // Close while the element still exists, so native modal state and opener
        // focus are restored before Blazor removes it from the render tree.
        if (_nodeDialog is not null) await _nodeDialog.CloseAsync();
        _additionTarget = null;
        _nodeDialog = null;
        _additionError = null;
        _relatedRequirements = [];
        if (_canvasModule is not null)
            await _canvasModule.InvokeVoidAsync("setAdditionDialogOpen", _canvasElement, false);
        _closingAddition = false;
        await InvokeAsync(StateHasChanged);
    }

    private static LayoutNodeKind? ChildKind(LayoutNodeKind parentKind) => parentKind switch
    {
        LayoutNodeKind.Background => LayoutNodeKind.TopLevelRequirement,
        LayoutNodeKind.TopLevelRequirement => LayoutNodeKind.LowerLevelRequirement,
        LayoutNodeKind.LowerLevelRequirement => LayoutNodeKind.Specification,
        _ => null
    };

    private static string NodeLabel(LayoutNodeKind kind) => kind switch
    {
        LayoutNodeKind.Background => "背景",
        LayoutNodeKind.TopLevelRequirement => "上位要求",
        LayoutNodeKind.LowerLevelRequirement => "下位要求",
        _ => "仕様"
    };

    private static string AdditionLabel(LayoutNodeKind kind) => $"{NodeLabel(kind)}を追加";

    [JSInvokable]
    public async Task<long> NodeSizesChanged(MeasuredNodeSize[] measurements)
    {
        if (_disposed) return _session.Revision;
        var changes = new Dictionary<string, NodeSize>(StringComparer.Ordinal);
        foreach (var measurement in measurements)
        {
            if (!double.IsFinite(measurement.Width) || !double.IsFinite(measurement.Height)
                || measurement.Width <= 0 || measurement.Height <= 0) continue;
            changes[measurement.Key] = new NodeSize(measurement.Width, measurement.Height);
        }
        try
        {
            if (!_session.ApplyMeasuredSizes(changes)) return _session.Revision;
            if (_session.AutomaticallyMovedBackgroundIds.Count > 0)
                _statusText = PlacementNotice("表示サイズを補正しました");
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException)
        {
            _statusText = $"表示サイズの補正を確定できませんでした：{error.Message}";
        }
        await InvokeAsync(StateHasChanged);
        return _session.Revision;
    }

    [JSInvokable]
    public Task CanvasChanged(double zoom, double panX, double panY)
    {
        _canvas.Synchronize(zoom, panX, panY, _settings);
        _session.SetViewport(_canvas.Zoom, _canvas.PanX, _canvas.PanY);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task ReasonChanged(string key, bool expanded)
    {
        if (_disposed || IsReasonExpanded(key) == expanded) return;
        try
        {
            if (!_session.SetReasonExpanded(key, expanded)) return;
            _statusText = PlacementNotice(expanded ? "理由を展開しました" : "理由を折りたたみました");
        }
        catch (Exception error) when (error is ArgumentException or InvalidOperationException)
        {
            if (_canvasModule is not null)
                await _canvasModule.InvokeVoidAsync("restoreReasonState", _canvasElement, key, IsReasonExpanded(key));
            _statusText = $"理由の表示変更を取り消しました：{error.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetZoom()
    {
        // JS refuses viewport changes during a tree gesture/commit, and reports
        // accepted changes through CanvasChanged. Do not change saved pan early.
        if (_canvasModule is not null) await _canvasModule.InvokeVoidAsync("resetCanvas", _canvasElement, _settings.InitialZoom);
    }

    private string WorldStyle => $"width:{Px(_layout.CanvasBounds.Width)}; height:{Px(_layout.CanvasBounds.Height)}";
    private string ToolbarToggleLabel => _toolbarVisible ? "メニューを隠す" : "メニューを表示";
    private string ToolbarSettingsStyle => $"--toolbar-toggle-size:{Px(_uiSettings.ToolbarToggleDiameter)};--toolbar-toggle-icon-size:{Px(_uiSettings.ToolbarToggleIconSize)};--toolbar-toggle-inset:{Px(_uiSettings.ToolbarToggleInset)}";
    private string SvgStyle => $"left:{Px(_layout.CanvasBounds.X)};top:{Px(_layout.CanvasBounds.Y)};--connection-stroke-width:{Px(_settings.ConnectionStrokeWidth)}";
    private string SvgViewBox => $"{Number(_layout.CanvasBounds.X)} {Number(_layout.CanvasBounds.Y)} {Number(_layout.CanvasBounds.Width)} {Number(_layout.CanvasBounds.Height)}";

    private string NodeStyle(LayoutNode node) =>
        $"left:{Px(node.Bounds.X)}; top:{Px(node.Bounds.Y)}; width:{Px(_settings.NodeWidth)}; min-height:{Px(_settings.MinNodeHeight)}";

    private static string Number(double value) => value.ToString("R", CultureInfo.InvariantCulture);
    private static string Px(double value) => $"{Number(value)}px";

    private static string PathFor(LayoutEdge edge) => string.Create(CultureInfo.InvariantCulture,
        $"M {edge.Start.X:R} {edge.Start.Y:R} C {edge.ControlPoint1.X:R} {edge.ControlPoint1.Y:R}, {edge.ControlPoint2.X:R} {edge.ControlPoint2.Y:R}, {edge.End.X:R} {edge.End.Y:R}");

    private static string NodeClass(LayoutNodeKind kind) => kind switch
    {
        LayoutNodeKind.Background => "background-node",
        LayoutNodeKind.Specification => "specification-node",
        _ => "requirement-node"
    };

    private bool IsReasonExpanded(string key) => _document.View.Nodes.TryGetValue(key, out var state) && state.ReasonExpanded;

    private string PlacementNotice(string message) => _session.AutomaticallyMovedBackgroundIds.Count == 0
        ? message
        : $"{message}。背景 {string.Join("、", _session.AutomaticallyMovedBackgroundIds)} を重複解消のため自動移動しました（配下のノード・接続線を含む）。";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_canvasModule is not null)
        {
            try
            {
                await _canvasModule.InvokeVoidAsync("detachCanvas", _canvasElement);
                await _canvasModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dotNetReference?.Dispose();
    }

    private static UsdmDocument CreateSampleDocument() => new()
    {
        Title = "USDM_MindMap_Editor サンプル",
        Backgrounds = [new() { Id = "001", Text = "顧客が簡単に操作できること" }],
        Requirements =
        [
            new() { Id = "001", Request = "操作はマウスだけで完結する", Reason = "誰でも利用可能にするため", ParentBackgroundId = "001" },
            new() { Id = "001-001", Request = "左クリックのみで編集できる", Reason = "学習コストを削減するため", ParentRequirementId = "001" }
        ],
        Specifications = [new() { Id = "001-001-001", Specification = "左クリックで入力ダイアログを表示する", ParentRequirementId = "001-001" }]
    };
}
